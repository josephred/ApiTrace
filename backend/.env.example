# ---------------------------------------------------------------------------
# ApiTrace API - variables de entorno
# Copie este archivo a .env y complete los valores. NUNCA versione el .env real.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---------------------------------------------------------------------------
# Base de datos: Neon (PostgreSQL gestionado)
#
# La cadena se copia del panel de Neon. Dos endpoints disponibles:
#   - directo:  ep-xxxx.region.aws.neon.tech          (una sola instancia)
#   - agrupado: ep-xxxx-pooler.region.aws.neon.tech   (varias instancias)
# Con mas de una instancia del web service, usar el agrupado: el limite de
# conexiones del plan gratuito se agota rapido.
#
# El TLS se activa solo al detectar neon.tech o sslmode=require en la URL.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=10
# DATABASE_SSL=true                     # forzar TLS si la deteccion automatica no alcanza
# DATABASE_CONNECTION_TIMEOUT_MS=20000  # Neon suspende el computo; despertarlo tarda segundos
# DATABASE_IDLE_TIMEOUT_MS=30000

# Base de datos para los tests e2e. Puede ser una rama de Neon o un PostgreSQL local.
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/apitrace_test

# ---------------------------------------------------------------------------
# Secretos JWT: minimo 32 caracteres y distintos entre si.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=otro-secreto-distinto-de-al-menos-32-caracteres-aqui
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=14

# CORS: lista separada por comas. Se acepta con o sin esquema.
#   ejemplo: https://apitrace-web.onrender.com,http://localhost:5173
CORS_ORIGINS=*

# OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Outbox de eventos de dominio
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=240

# Password de los usuarios del seed de demostracion
SEED_PASSWORD=ApiTrace2026!
