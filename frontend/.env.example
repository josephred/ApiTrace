# URL del backend. Se acepta con o sin esquema.
#   desarrollo: dejar vacio y usar el proxy de Vite hacia http://localhost:3000
#   produccion: https://apitrace-api.onrender.com
VITE_API_URL=

# Acceso rapido con los usuarios del seed en la pantalla de ingreso.
#   Solo para una instancia de DEMOSTRACION con datos ficticios. Nunca en la
#   instancia con datos reales: cualquiera entraria con cualquier rol.
#   En desarrollo (npm run dev) se muestra siempre.
VITE_DEMO_ACCESS=false
