{
  "name": "apitrace-web",
  "version": "0.1.0",
  "description": "ApiTrace - aplicacion web instalable (PWA) con modo offline para trazabilidad apicola.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
