+  it('un documento sin fechas conserva su estado (remitos y DT-e anteriores a la migracion)', () => {
+    expect(effectiveStatus('EMITIDO', { loadDate: null, expiryDate: null }, new Date())).toBe(
+      'EMITIDO',
