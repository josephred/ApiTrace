+# ---------------------------------------------------------------------------
+# Integracion SENASA (DT-e API-SEM)
+#
+# SENASA_MODE elige como se emiten los DT-e:
+#   manual    (por defecto) sin API: el DT-e se emite en SIGSA y en ApiTrace se
+#             registra el numero y el codigo de cierre impresos.
+#   simulado  circuito completo contra un simulador. Los numeros llevan prefijo
+#             SIM- y NO tienen validez oficial. Solo para demos y pruebas.
+#   sigsa     API oficial de SENASA. Requiere contrato y credenciales (pendiente).
+# ---------------------------------------------------------------------------
+SENASA_MODE=manual
+# homologacion | produccion (solo aplica a SENASA_MODE=sigsa)
+SENASA_ENV=homologacion
+# URL base de la API de SENASA que se acuerde (solo SENASA_MODE=sigsa)
+# SENASA_SIGSA_URL=
+# CUIT de ApiTrace como representante (a quien los titulares delegan SIGSA/SITA)
+# SENASA_PLATFORM_CUIT=
+SENASA_TIMEOUT_MS=15000
+
+# Barrido de vigencia del DT-e (EMITIDO -> VIGENTE -> VENCIDO -> CADUCADO)
+DTE_LIFECYCLE_ENABLED=true
+DTE_LIFECYCLE_INTERVAL_MS=600000
