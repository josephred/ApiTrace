+        string,
+        number
+      >;
+    };
+    const countWhere = async (...conditions: (SQL | undefined)[]) => {
+      const rows = await this.db
+        .select({ count: sql<number>`cast(count(*) as int)` })
+        .from(dte)
+        .where(and(...conditions.filter((c): c is SQL => Boolean(c))));
+      return rows[0]?.count ?? 0;
+    };
