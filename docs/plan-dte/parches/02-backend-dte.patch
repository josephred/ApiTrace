+        countWhere(issuedBy, eq(dte.status, 'VIGENTE'), eq(dte.expiryDate, today)),
+        countWhere(issuedBy, eq(dte.status, 'CADUCADO'), isNull(dte.regularizedAt)),
+        countWhere(receivedBy, inArray(dte.status, ['VIGENTE', 'VENCIDO'])),
